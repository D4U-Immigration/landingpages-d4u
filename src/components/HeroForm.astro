---
/**
 * Card do formulário HubSpot no hero (embed v2 — padrão do catálogo oficial de forms).
 *
 * Desempenho: o script do HubSpot (~200 KB e cookies de terceiros) só é baixado na primeira
 * interação do visitante (rolar, tocar, mover o mouse, teclar) ou se a URL já chegar com a
 * âncora do formulário. Até lá o card mostra um esqueleto com a altura final do form reservada
 * (components.css → "Formulário com carregamento sob demanda"), então nada pula quando ele aparece.
 *
 * O Lead é registrado pelo loader de tracking; não chamar pmaTrack aqui.
 */
import { HUBSPOT_PORTAL_ID, HUBSPOT_REGION } from 'astro:env/server';

interface Props {
  anchor: string;
  formId: string;
  /** Texto do selo giratório (ex.: "ANÁLISE 100% GRATUITA •"); sem texto, sem selo */
  seal?: string;
  /** Altura do form já carregado com o card em <380, 380–400 (1 coluna) e >400 px (2 colunas) de largura — medir ao trocar de form */
  heights?: [number, number, number];
  /** Card sobre fundo claro (sombra suave), para páginas sem hero escuro */
  light?: boolean;
}
const { anchor, formId, seal, heights, light = false } = Astro.props;
const style = heights && `--form-h: ${heights[0]}px; --form-h-380: ${heights[1]}px; --form-h-2col: ${heights[2]}px`;
const portalId = HUBSPOT_PORTAL_ID;
const region = HUBSPOT_REGION;
---
<div class:list={['hero-form', { 'hero-form--light': light }]} id={anchor} style={style}>
  {seal && <div class="seal" aria-hidden="true">
    <svg class="seal__ring" viewBox="0 0 100 100">
      <defs><path id="sealPath" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0"/></defs>
      <text><textPath href="#sealPath" textLength="232" lengthAdjust="spacing">{seal}</textPath></text>
    </svg>
    <span class="seal__center">
      <svg viewBox="0 0 20 20" width="22" height="22"><path d="M5 10.5l3.2 3.2L15 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>}
  <div class="hs-form-v2" id="hsForm"></div>
  <script is:inline define:vars={{ region, portalId, formId, anchor }}>
    (function () {
      var EVENTS = ['scroll', 'pointerdown', 'pointermove', 'touchstart', 'keydown', 'focusin'];
      var started = false;
      function load() {
        if (started) return;
        started = true;
        EVENTS.forEach(function (e) { window.removeEventListener(e, load, { passive: true }); });
        var s = document.createElement('script');
        s.src = 'https://js.hsforms.net/forms/embed/v2.js';
        s.async = true;
        s.onload = function () {
          window.hbspt.forms.create({ region: region, portalId: portalId, formId: formId, target: '#hsForm' });
        };
        document.head.appendChild(s);
      }
      EVENTS.forEach(function (e) { window.addEventListener(e, load, { passive: true }); });
      if (location.hash === '#' + anchor) load();
    })();
  </script>
</div>
