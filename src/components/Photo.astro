---
/**
 * Foto com WebP responsivo (-640/-960 + original) + fallback JPG. `src` sem extensão,
 * ex.: "/assets/lp/eb2-niw/o-que-e". `width`/`height` = tamanho da original; as versões menores
 * que ela (-640, -960) são geradas por `npm run images`.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  /** Largura exibida, para o navegador escolher a versão certa */
  sizes?: string;
}
const { src, alt, width = 1200, height = 800, class: cls, sizes = '(min-width: 900px) 540px, calc(100vw - 48px)' } = Astro.props;
const srcset = [...[640, 960].filter((w) => w < width).map((w) => `${src}-${w}.webp ${w}w`), `${src}.webp ${width}w`].join(', ');
---
<picture>
  <source srcset={srcset} sizes={sizes} type="image/webp">
  <img class={cls} src={`${src}.jpg`} alt={alt} width={width} height={height} loading="lazy" decoding="async">
</picture>
