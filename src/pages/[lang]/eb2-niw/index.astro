---
/**
 * LP Visto EB-2 NIW — gera /pt-br/eb2-niw/, /en/eb2-niw/ e /es/eb2-niw/.
 * Textos: src/content/lps/eb2-niw/{idioma}.json (literais aos PDFs aprovados).
 * Formulário HubSpot por idioma: src/config/lps.js.
 */
import { SITE_URL } from 'astro:env/server';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HeroForm from '../../../components/HeroForm.astro';
import CtaButton from '../../../components/CtaButton.astro';
import CheckToggle from '../../../components/CheckToggle.astro';
import Photo from '../../../components/Photo.astro';
import VideoStories from '../../../components/VideoStories.astro';
import VideoModal from '../../../components/VideoModal.astro';
import CredGrid from '../../../components/CredGrid.astro';
import Awards from '../../../components/Awards.astro';
import Faq from '../../../components/Faq.astro';
import CtaBand from '../../../components/CtaBand.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import StickyCta from '../../../components/StickyCta.astro';
import { LPS } from '../../../config/lps.js';
import { imageSet, stripHtml } from '../../../config/helpers.js';

const SLUG = 'eb2-niw';
const LP = LPS[SLUG];
const IMG = `/assets/lp/${SLUG}`;
const content = import.meta.glob('../../../content/lps/eb2-niw/*.json', { eager: true, import: 'default' });

export function getStaticPaths() {
  return LPS['eb2-niw'].locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'pt-br' | 'en' | 'es' };
const t: any = content[`../../../content/lps/eb2-niw/${lang}.json`];
const a = t.anchors;
const formHref = `#${a.form}`;

const site = SITE_URL.replace(/\/$/, '');
const pageUrl = `${site}/${lang}/${SLUG}/`;
const inLanguage = { 'pt-br': 'pt-BR', en: 'en', es: 'es' }[lang];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://d4uimmigration.com/#organization',
      name: 'D4U Immigration',
      url: 'https://d4uimmigration.com',
      logo: 'https://d4uimmigration.com/wp-content/themes/d4u/assets/images/2025/Logo_D4U_cb2.svg',
      foundingDate: '2015',
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t.meta.pageName,
      description: t.meta.pageDescription,
      inLanguage,
      primaryImageOfPage: `${site}${IMG}/og-eb2-niw.jpg`,
      publisher: { '@id': 'https://d4uimmigration.com/#organization' },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      about: { '@type': 'Thing', name: t.meta.about },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'D4U Immigration', item: 'https://d4uimmigration.com/' },
        { '@type': 'ListItem', position: 2, name: t.meta.breadcrumbName, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      inLanguage,
      mainEntity: t.faq.items.map((it: { q: string; a: string }) => ({
        '@type': 'Question',
        name: stripHtml(it.q),
        acceptedAnswer: { '@type': 'Answer', text: stripHtml(it.a) },
      })),
    },
  ],
};

const ROUTE_ICONS = [
  '<path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v6"/>',
  '<path d="M12 2l2.9 6.1 6.6.8-4.9 4.6 1.3 6.5L12 16.8 6.1 20l1.3-6.5L2.5 8.9l6.6-.8L12 2z"/>',
];
const ADV_ICONS = [
  '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M4 4l16 16"/>',
  '<rect x="2.5" y="5" width="19" height="14" rx="2"/><circle cx="8.5" cy="11" r="2.2"/><path d="M5.5 16c.6-1.6 1.7-2.4 3-2.4s2.4.8 3 2.4"/><path d="M14.5 10h4M14.5 13.5h3"/>',
  '<path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
];
---
<BaseLayout
  locale={lang}
  path={`${SLUG}/`}
  locales={LP.locales}
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogImage={`${IMG}/og-eb2-niw.jpg`}
  ogImageAlt={t.meta.ogImageAlt}
  preloadImage={`${IMG}/hero-bg.webp`}
  hubspotForm
  preconnect={['https://img.youtube.com']}
  jsonLd={jsonLd}
>
<SiteHeader formAnchor={a.form} cta={t.cta.header} />

<main>

<section class="hero" aria-labelledby="hero-title" style={`--hero-bg: ${imageSet(`${IMG}/hero-bg`)}`}>
  <div class="container hero__grid">
    <div class="hero__content">
      <span class="free-badge"><span class="free-badge__dot" aria-hidden="true"></span><Fragment set:html={t.hero.badge} /></span>
      <h1 id="hero-title" set:html={t.hero.title} />
      <p class="lede" set:html={t.hero.lede} />
      <p class="lede lede--strong" set:html={t.hero.strong} />
      <div class="hero__actions">
        <CtaButton href={formHref} html={t.hero.cta} />
      </div>
    </div>
    <HeroForm anchor={a.form} formId={LP.forms[lang]} seal={t.hero.seal} />
  </div>
</section>

<section class="section section--white" id={a.whatIs} aria-labelledby={`${a.whatIs}-title`}>
  <div class="container">
    <div class="reveal section-grid">
      <div class="section-grid__text">
        <span class="eyebrow" set:html={t.whatIs.eyebrow} />
        <h2 id={`${a.whatIs}-title`} set:html={t.whatIs.title} />
        <div style="margin-top:1.1rem">
          {t.whatIs.paragraphs.map((p: string) => <p class="lede" set:html={p} />)}
        </div>
      </div>
      <div class="section-grid__media">
        <Photo class="section-photo" src={`${IMG}/o-que-e`} alt={t.whatIs.imageAlt} />
      </div>
    </div>

    <div class="reveal check-card" id={a.whoCan}>
      <div>
        <h3 set:html={t.whoCan.title} />
        <p class="lede" set:html={t.whoCan.lede} />
        <div class="check-meter" aria-hidden="true">{t.whoCan.items.map(() => <span></span>)}</div>
        <p class="foot-note" set:html={t.whoCan.note} />
      </div>
      <ul class="check-toggle-list">
        {t.whoCan.items.map((item: string) => <CheckToggle html={item} />)}
      </ul>
    </div>
  </div>
</section>

<section class="section section--light" id={a.requirements} aria-labelledby={`${a.requirements}-title`}>
  <div class="container">
    <div class="reveal section-grid section-grid--reverse">
      <div class="section-grid__text">
        <span class="eyebrow" set:html={t.requirements.eyebrow} />
        <h2 id={`${a.requirements}-title`} set:html={t.requirements.title} />
        <p class="lede" style="margin-top:1.1rem" set:html={t.requirements.lede} />
      </div>
      <div class="section-grid__media">
        <Photo class="section-photo" src={`${IMG}/requisitos`} alt={t.requirements.imageAlt} />
      </div>
    </div>

    <div class="reveal route-grid">
      {t.requirements.routes.map((route: { title: string; items: string[] }, i: number) => (
        <>
          {i > 0 && <span class="route-or" aria-hidden="true">{t.requirements.or}</span>}
          <article class="route-card">
            <div class="route-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ROUTE_ICONS[i]} />
            </div>
            <h3 set:html={route.title} />
            <ul>{route.items.map((li) => <li set:html={li} />)}</ul>
          </article>
        </>
      ))}
    </div>

    <div class="reveal section-cta">
      <p class="lede" set:html={t.requirements.closing} />
      <CtaButton href={formHref} html={t.requirements.cta} />
    </div>
  </div>
</section>

<section class="section section--white" id={a.advantages} aria-labelledby={`${a.advantages}-title`}>
  <div class="container">
    <div class="reveal">
      <span class="eyebrow" set:html={t.advantages.eyebrow} />
      <h2 id={`${a.advantages}-title`} style={t.advantages.titleStyle} set:html={t.advantages.title} />
    </div>
    <div class="reveal adv-layout">
      <div class="adv-photo">
        <Photo src={`${IMG}/vantagens`} alt={t.advantages.imageAlt} />
      </div>
      <div class="adv-grid">
        {t.advantages.cards.map((card: { title: string; text: string }, i: number) => (
          <article class="adv-card">
            <div class="adv-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ADV_ICONS[i]} />
            </div>
            <h3 set:html={card.title} />
            <p set:html={card.text} />
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="section section--light" id={a.profiles} aria-labelledby={`${a.profiles}-title`}>
  <div class="container">
    <div class="reveal section-grid">
      <div class="section-grid__text">
        <span class="eyebrow" set:html={t.profiles.eyebrow} />
        <h2 id={`${a.profiles}-title`} set:html={t.profiles.title} />
        <p class="lede" style="margin:1.1rem 0" set:html={t.profiles.lede} />
        <p class="lede" style="margin-bottom:1.25rem" set:html={t.profiles.listIntro} />
        <ul class="chip-grid chip-grid--interactive" style="list-style:none;margin:0;padding:0">
          {t.profiles.chips.map((chip: string) => <li class="chip" set:html={chip} />)}
        </ul>
      </div>
      <div class="section-grid__media">
        <Photo class="section-photo" src={`${IMG}/para-quem`} alt={t.profiles.imageAlt} />
      </div>
    </div>
    <div class="reveal section-cta">
      <div class="callout para-quem-callout" style="text-align:left;max-width:820px">
        <p set:html={t.profiles.callout} />
      </div>
      <CtaButton href={formHref} html={t.profiles.cta} />
    </div>
  </div>
</section>

<section class="section section--navy" id={a.stories} aria-labelledby={`${a.stories}-title`}>
  <div class="container">
    <div class="reveal stories-head">
      <span class="eyebrow" set:html={t.stories.eyebrow} />
      <h2 id={`${a.stories}-title`} set:html={t.stories.title} />
    </div>

    <VideoStories videos={t.stories.videos} moreHref={t.stories.moreHref} more={t.stories.more} />

    <div class="reveal stories-head" style="margin:2.75rem auto 0">
      <p class="lede" set:html={t.stories.closing} />
    </div>

    <CredGrid items={t.stories.creds} />
  </div>
</section>

<Awards label={t.awards.label} alts={t.awards.alts} />

<Faq anchor={a.faq} eyebrow={t.faq.eyebrow} title={t.faq.title} items={t.faq.items} />

<CtaBand
  anchor={a.ctaFinal}
  formAnchor={a.form}
  background={imageSet(`${IMG}/cta-final`)}
  eyebrow={t.ctaFinal.eyebrow}
  title={t.ctaFinal.title}
  ledes={t.ctaFinal.ledes}
  cta={t.ctaFinal.cta}
/>

</main>

<SiteFooter html={t.footer.html} lang={t.footer.lang} />

<VideoModal label={t.stories.modalLabel} closeLabel={t.stories.closeLabel} />

<StickyCta formAnchor={a.form} cta={t.cta.sticky} />
</BaseLayout>
