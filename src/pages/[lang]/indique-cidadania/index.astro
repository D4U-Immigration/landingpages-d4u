---
/**
 * LP Indique e ganhe sua cidadania americana — campanha de indicação para clientes (só pt-br).
 * Textos: src/content/lps/indique-cidadania/pt-br.json (literais ao briefing aprovado).
 * Formulário HubSpot: src/config/lps.js. CSS exclusivo: styles/indique-cidadania.css.
 */
import { SITE_URL } from 'astro:env/server';
import LpLayout from '../../../layouts/LpLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import HeroForm from '../../../components/HeroForm.astro';
import CtaButton from '../../../components/CtaButton.astro';
import Photo from '../../../components/Photo.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import StickyCta from '../../../components/StickyCta.astro';
import { LPS } from '../../../config/lps.js';
import { imageSet } from '../../../config/helpers.js';
import '../../../styles/indique-cidadania.css';

const SLUG = 'indique-cidadania';
const LP = LPS[SLUG];
const IMG = `/assets/lp/${SLUG}`;
const content = import.meta.glob('../../../content/lps/indique-cidadania/*.json', { eager: true, import: 'default' });

export function getStaticPaths() {
  return LPS['indique-cidadania'].locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'pt-br' };
const t: any = content[`../../../content/lps/indique-cidadania/${lang}.json`];
const a = t.anchors;
const formHref = `#${a.form}`;
const formId: string | undefined = LP.forms[lang];

const site = SITE_URL.replace(/\/$/, '');
const pageUrl = `${site}/${lang}/${SLUG}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://d4uimmigration.com/#organization',
      name: 'D4U Immigration',
      url: 'https://d4uimmigration.com',
      logo: 'https://d4uimmigration.com/wp-content/themes/d4u/assets/images/2025/Logo_D4U_cb2.svg',
      foundingDate: '2015',
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t.meta.pageName,
      description: t.meta.pageDescription,
      inLanguage: 'pt-BR',
      primaryImageOfPage: `${site}${IMG}/og-${SLUG}.jpg`,
      publisher: { '@id': 'https://d4uimmigration.com/#organization' },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      about: { '@type': 'Thing', name: t.meta.about },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'D4U Immigration', item: 'https://d4uimmigration.com/' },
        { '@type': 'ListItem', position: 2, name: t.meta.breadcrumbName, item: pageUrl },
      ],
    },
  ],
};

const STEP_ICONS = [
  // pessoas (escolha quem indicar)
  '<circle cx="9" cy="8" r="3.2"/><path d="M3 19c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9" r="2.5"/><path d="M16.5 14c2.4.2 4 1.8 4.5 4.5"/>',
  // formulário (faça sua indicação)
  '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3.5h6v2.5H9z"/><path d="M8.5 11h7M8.5 14.5h7M8.5 18h4"/>',
  // passaporte/estrela (ganhe seu processo de cidadania)
  '<path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.5L12 17.3 6.1 20.5l1.3-6.5L2.5 9.4l6.6-.8L12 2.5z"/>',
];
---
<LpLayout
  locale={lang}
  path={`${SLUG}/`}
  locales={LP.locales}
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  ogImage={`${IMG}/og-${SLUG}.jpg`}
  ogImageAlt={t.meta.ogImageAlt}
  preloadImages={[
    { href: `${IMG}/hero-bg-800.webp`, media: '(max-width: 799px)' },
    { href: `${IMG}/hero-bg.webp`, media: '(min-width: 800px)' },
  ]}
  dnsPrefetch={['https://js.hsforms.net']}
  jsonLd={jsonLd}
>
<SiteHeader formAnchor={a.form} cta={t.cta.header} />

<main>

<section class="hero" aria-labelledby="hero-title" style={`--hero-bg: ${imageSet(`${IMG}/hero-bg`)}; --hero-bg-sm: url("${IMG}/hero-bg-800.webp")`}>
  <div class="container hero__grid">
    <div class="hero__content">
      <h1 id="hero-title" set:html={t.hero.title} />
      <p class="lede lede--strong" set:html={t.hero.lede} />
      <p class="lede" set:html={t.hero.strong} />
      <div class="hero__actions">
        <CtaButton href={formHref} html={t.hero.cta} />
      </div>
    </div>
    {/* Altura do form medida em 2026-11-19 (card 299/393/473+ px): 1154/1136/850 — remedir se o form mudar */}
    {formId
      ? <HeroForm anchor={a.form} formId={formId} heights={[1154, 1136, 850]} />
      : (
        /* Form HubSpot ainda não definido: card reservado até o ID chegar (src/config/lps.js) */
        <div class="hero-form" id={a.form}><div class="hs-form-v2" id="hsForm"></div></div>
      )}
  </div>
</section>

<section class="section section--white" id={a.conquest} aria-labelledby={`${a.conquest}-title`}>
  <div class="container">
    <div class="reveal section-grid">
      <div class="section-grid__text">
        <h2 id={`${a.conquest}-title`} set:html={t.conquest.title} />
        <div style="margin-top:1.1rem">
          {t.conquest.paragraphs.map((p: string) => <p class="lede" set:html={p} />)}
        </div>
      </div>
      <div class="section-grid__media">
        <Photo class="section-photo" src={`${IMG}/conquista`} alt={t.conquest.imageAlt} />
      </div>
    </div>
  </div>
</section>

<section class="cid-prize" id={a.prize} aria-labelledby={`${a.prize}-title`}>
  <div class="container reveal cid-prize__inner">
    <h2 id={`${a.prize}-title`} class="cid-prize__head">
      <span class="cid-prize__value" data-count="2" data-decimals="3" data-decimal-sep="." data-prefix="US$ ">{t.prize.value}</span>
      <span class="cid-prize__label" set:html={t.prize.label} />
    </h2>
    <p class="cid-prize__eq">
      <span set:html={t.prize.equation[0]} />
      <span class="cid-prize__eq-sign">=</span>
      <span set:html={t.prize.equation[1]} />
    </p>
    <p class="cid-prize__text" set:html={t.prize.text} />
  </div>
</section>

<section class="section section--light" id={a.steps} aria-labelledby={`${a.steps}-title`}>
  <div class="container">
    <div class="reveal section-grid section-grid--reverse">
      <div class="section-grid__text">
        <h2 id={`${a.steps}-title`} set:html={t.steps.title} />
        <p class="lede" style="margin-top:1.1rem" set:html={t.steps.lede} />
      </div>
      <div class="section-grid__media">
        <Photo class="section-photo" src={`${IMG}/passos`} alt={t.steps.imageAlt} />
      </div>
    </div>

    <ol class="reveal cid-steps">
      {t.steps.items.map((step: { title: string; text: string }, i: number) => (
        <li class="cid-step">
          <span class="cid-step__num" aria-hidden="true">{i + 1}</span>
          <div class="cid-step__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={STEP_ICONS[i]} />
          </div>
          <h3 set:html={step.title} />
          <p set:html={step.text} />
        </li>
      ))}
    </ol>

    <div class="reveal section-cta">
      <div class="callout" style="text-align:left;max-width:820px">
        <p set:html={t.steps.callout} />
      </div>
      <a class="cid-terms" href={t.steps.termsHref} target="_blank" rel="noopener" set:html={t.steps.termsText} />
      <CtaButton href={formHref} html={t.hero.cta} />
    </div>
  </div>
</section>

<section class="cta-band" id={a.ctaFinal} aria-labelledby={`${a.ctaFinal}-title`} style={`--cta-bg: ${imageSet(`${IMG}/cta-final`)}`}>
  <div class="container reveal">
    <h2 id={`${a.ctaFinal}-title`} set:html={t.ctaFinal.title} />
    <p class="lede lede--strong" set:html={t.ctaFinal.lede} />
    <CtaButton href={formHref} html={t.ctaFinal.cta} />
  </div>
</section>

</main>

<SiteFooter html={t.footer.html} lang={t.footer.lang} />

<StickyCta formAnchor={a.form} cta={t.cta.sticky} />

<script>
  // Ponto de luz da faixa do prêmio segue o mouse (só com mouse de verdade e sem movimento reduzido)
  const prize = document.querySelector<HTMLElement>('.cid-prize');
  const canFollow = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (prize && canFollow) {
    let frame = 0;
    prize.addEventListener('pointermove', (e) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const r = prize.getBoundingClientRect();
        prize.style.setProperty('--glow-x', `${e.clientX - r.left}px`);
        prize.style.setProperty('--glow-y', `${e.clientY - r.top}px`);
      });
    });
    prize.addEventListener('pointerleave', () => {
      prize.style.removeProperty('--glow-x');
      prize.style.removeProperty('--glow-y');
    });
  }
</script>
</LpLayout>
