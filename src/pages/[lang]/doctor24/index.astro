---
/**
 * LP Benefício Doctor24 — gera /pt-br/doctor24/, /en/doctor24/ e /es/doctor24/.
 * Página IGUAL à original (pedido do usuário, 2026-11-04: "não mudar nada, deixar o app lá"):
 * HTML literal (src/content/lps/doctor24/{idioma}.json), base.css + o page.css original
 * (styles/doctor24.css), sem o CSS compartilhado das LPs.
 * Única diferença: os botões (antes href="#") abrem o form "Fale conosco" do catálogo numa janela
 * por cima da página (FormModal); depois do envio, vai para /{idioma}/doctor24-thank-you/.
 */
import { SITE_URL } from 'astro:env/server';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormModal from '../../../components/FormModal.astro';
import { LPS } from '../../../config/lps.js';
import '../../../styles/base.css';
import '../../../styles/doctor24.css';

const SLUG = 'doctor24';
const LP = LPS[SLUG];
const content = import.meta.glob('../../../content/lps/doctor24/*.json', { eager: true, import: 'default' });

export function getStaticPaths() {
  return LPS['doctor24'].locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: 'pt-br' | 'en' | 'es' };
const t: any = content[`../../../content/lps/doctor24/${lang}.json`];
const CLOSE = { 'pt-br': 'Fechar', en: 'Close', es: 'Cerrar' }[lang];

const site = SITE_URL.replace(/\/$/, '');
const pageUrl = `${site}/${lang}/${SLUG}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://d4uimmigration.com/#organization',
      name: 'D4U Immigration',
      url: 'https://d4uimmigration.com',
      logo: 'https://d4uimmigration.com/wp-content/themes/d4u/assets/images/2025/Logo_D4U_cb2.svg',
      foundingDate: '2015',
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t.meta.title,
      description: t.meta.description,
      inLanguage: { 'pt-br': 'pt-BR', en: 'en', es: 'es' }[lang],
      publisher: { '@id': 'https://d4uimmigration.com/#organization' },
    },
  ],
};
---
<BaseLayout
  locale={lang}
  path={`${SLUG}/`}
  locales={LP.locales}
  title={t.meta.title}
  description={t.meta.description}
  ogTitle={t.meta.ogTitle}
  dnsPrefetch={['https://js.hsforms.net']}
  jsonLd={jsonLd}
>
<Fragment set:html={t.body} />
<FormModal formId={LP.forms[lang]} redirectUrl={`${site}/${lang}/doctor24-thank-you/`} closeLabel={CLOSE} label={t.meta.title} />
</BaseLayout>
