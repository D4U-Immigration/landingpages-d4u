---
/**
 * Redirecionamentos das URLs antigas (/lp/{nome}/ e /lp/{nome}/{idioma}/) para a estrutura
 * nova (/{idioma}/{nome}/). Gera um index.html em cada URL antiga, sem depender de .htaccess,
 * preservando UTMs e demais parâmetros. Só para LPs com `legacy: true` em config/lps.js.
 */
import RedirectLayout from '../../layouts/RedirectLayout.astro';
import { LPS } from '../../config/lps.js';
import { DEFAULT_LOCALE } from '../../config/locales.js';

export function getStaticPaths() {
  return Object.entries(LPS)
    .filter(([, lp]) => lp.legacy)
    .flatMap(([slug, lp]) => [
      { params: { legacy: slug }, props: { target: `/${lp.locales.includes(DEFAULT_LOCALE) ? DEFAULT_LOCALE : lp.locales[0]}/${slug}/`, name: lp.name } },
      ...lp.locales.map((l) => ({ params: { legacy: `${slug}/${l}` }, props: { target: `/${l}/${slug}/`, name: lp.name } })),
    ]);
}
---
<RedirectLayout {...Astro.props} />
