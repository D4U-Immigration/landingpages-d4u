---
/**
 * Layout base de toda página (home, LPs, ebooks): <head> completo (tracking, SEO, Open Graph,
 * hreflang, JSON-LD, fonte local pré-carregada). As LPs usam o LpLayout, que acrescenta o CSS
 * dos componentes, a barra de progresso de leitura e o lp.js.
 * O CSS é importado por quem usa este layout (LpLayout, home), sempre base.css primeiro: o Astro ordena o
 * CSS pela profundidade do import, e um base.css importado aqui sairia depois do CSS da página.
 * O CSS sai embutido no HTML (astro.config → inlineStylesheets) e não há fonte/CSS de terceiros
 * bloqueando a renderização.
 */
import { SITE_URL, TRACKING_LOADER_URL } from 'astro:env/server';
import { LOCALES, DEFAULT_LOCALE } from '../config/locales.js';

interface Props {
  locale: keyof typeof LOCALES;
  /** Caminho da página sem o idioma, ex.: "eb2-niw/" */
  path: string;
  /** Página fora da estrutura /{idioma}/ (ex.: a home "/"): canonical neste caminho, sem hreflang */
  canonicalPath?: string;
  /** Idiomas em que esta página existe (para hreflang) */
  locales: (keyof typeof LOCALES)[];
  title: string;
  description: string;
  ogTitle: string;
  /** og:description/twitter:description, quando diferente da meta description */
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Imagens do hero carregadas com prioridade (WebP), opcionalmente por media query */
  preloadImages?: { href: string; media?: string }[];
  /** Domínios usados depois do carregamento (ex.: js.hsforms.net, img.youtube.com): só resolve o DNS */
  dnsPrefetch?: string[];
  jsonLd?: object;
  bodyClass?: string;
  /** Padrão: indexar. A 404 usa "noindex, follow". */
  robots?: string;
}

const { locale, path, canonicalPath, locales, title, description, ogTitle, ogDescription = description, ogImage, ogImageAlt, preloadImages = [], dnsPrefetch = [], jsonLd, bodyClass, robots = 'index, follow, max-image-preview:large' } = Astro.props;
const site = SITE_URL.replace(/\/$/, '');
const urlFor = (l: string) => `${site}/${l}/${path}`;
const canonical = canonicalPath ? site + canonicalPath : urlFor(locale);
const alternates = canonicalPath ? [] : locales;
const ogImageUrl = ogImage && (ogImage.startsWith('http') ? ogImage : site + ogImage);
const favicon = 'https://d4uimmigration.com/wp-content/uploads/2025/04/favicon.png';
---
<!doctype html>
<html lang={LOCALES[locale].htmlLang} class="no-js">
<head>
<meta charset="UTF-8">
<script is:inline>document.documentElement.className = document.documentElement.className.replace("no-js", "js");</script>
<!-- Tracking D4U: o loader já registra sozinho o Lead do form HubSpot (v2 e v4), com dedup por sessão — não chamar pmaTrack('Lead') manualmente.
     Desempenho (decisão de 2026-11-02): o loader (GA4 + pixel da Meta) carrega na primeira interação ou 5 s após o load.
     O Lead não é afetado: enviar o form exige interação, e o loader captura o envio por evento.
     Lead manual (clique para Sympla, share.hsforms…): usar window.d4uLead({ method, page }) — ele carrega o
     loader se preciso e dispara o pmaTrack('Lead') assim que estiver disponível. -->
<script is:inline define:vars={{ loaderUrl: TRACKING_LOADER_URL }}>
  (function () {
    var EVENTS = ['scroll', 'pointerdown', 'pointermove', 'touchstart', 'keydown', 'focusin'];
    var started = false;
    function load() {
      if (started) return;
      started = true;
      EVENTS.forEach(function (e) { window.removeEventListener(e, load, { passive: true }); });
      var s = document.createElement('script');
      s.src = loaderUrl;
      s.async = true;
      document.head.appendChild(s);
    }
    EVENTS.forEach(function (e) { window.addEventListener(e, load, { passive: true }); });
    window.addEventListener('load', function () { setTimeout(load, 5000); });
    window.d4uLead = function (params) {
      load();
      var tries = 0;
      (function send() {
        if (typeof window.pmaTrack === 'function') return window.pmaTrack('Lead', params);
        if (++tries < 75) setTimeout(send, 200);
      })();
    };
  })();
</script>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<meta name="theme-color" content="#1F2A44">

<link rel="icon" href={favicon} sizes="32x32">
<link rel="icon" href={favicon} sizes="192x192">
<link rel="apple-touch-icon" href={favicon}>

<link rel="canonical" href={canonical}>
{alternates.map((l) => <link rel="alternate" hreflang={LOCALES[l].hreflang} href={urlFor(l)}>)}
{alternates.includes(DEFAULT_LOCALE) && <link rel="alternate" hreflang="x-default" href={urlFor(DEFAULT_LOCALE)}>}

<meta property="og:type" content="website">
<meta property="og:locale" content={LOCALES[locale].og}>
{alternates.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALES[l].og}>)}
<meta property="og:site_name" content="D4U Immigration">
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:url" content={canonical}>
{ogImageUrl && <>
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
</>}
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'}>
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl}>}

<link rel="preload" as="font" href="/assets/fonts/montserrat-latin.woff2" type="font/woff2" crossorigin>
{preloadImages.map((img) => <link rel="preload" as="image" href={img.href} type="image/webp" media={img.media} fetchpriority="high">)}
{dnsPrefetch.map((href) => <link rel="dns-prefetch" href={href}>)}

{jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />}
</head>
<body class={bodyClass}>

<slot />

<script>
  import '../scripts/base.js';
</script>
</body>
</html>
